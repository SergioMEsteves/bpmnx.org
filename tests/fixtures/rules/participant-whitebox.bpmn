<?xml version="1.0" encoding="UTF-8"?>
<!-- WhiteBox participant envelope: deny at pool, allow at element -> contradiction; time budget min across pool/element -->
<!-- expect: E-CONTRADICTION@T -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmnx="http://bpmnx.org/schema/1.1/bpmnx" id="D" targetNamespace="http://example.org/t">
<bpmn:collaboration id="C"><bpmn:participant id="Pool" processRef="P">
  <bpmn:extensionElements><bpmnx:participantEnhancement version="1.1" determinism="nondeterministic" boundary="whiteBox"><bpmnx:envelope timeBudget="PT5M"><bpmnx:toolDeny ref="pay.wire"/></bpmnx:envelope></bpmnx:participantEnhancement></bpmn:extensionElements>
</bpmn:participant></bpmn:collaboration>
<bpmn:process id="P">
  <bpmn:startEvent id="S"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
  <bpmn:serviceTask id="T"><bpmn:extensionElements><bpmnx:enhancement version="1.1" determinism="nondeterministic"><bpmnx:envelope timeBudget="PT1H"><bpmnx:toolAllow ref="pay.wire"/></bpmnx:envelope></bpmnx:enhancement></bpmn:extensionElements><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
  <bpmn:endEvent id="E"><bpmn:incoming>f2</bpmn:incoming></bpmn:endEvent>
  <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T"/><bpmn:sequenceFlow id="f2" sourceRef="T" targetRef="E"/>
</bpmn:process>
</bpmn:definitions>
